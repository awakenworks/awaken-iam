# Example environment for the standalone awaken-iam daemon.
#
# Copy this file to `.env` (git-ignored) and replace every placeholder with a
# real deployment coordinates. This template contains NO secrets. See
# docs/design/provider-setup.md for upstream app and callback registration.
#
# Production deployments inject these from a platform secret manager instead of
# a `.env` file; client secrets must never be committed (guardrail G5).

# --- IAM origin -------------------------------------------------------------
# Public base URL of this IAM deployment. Local default shown; production uses
# an https origin. The *_REDIRECT_URI values below must use this same origin.
IAM_BIND_ADDR=127.0.0.1:8080
IAM_ISSUER=http://127.0.0.1:8080
IAM_DATABASE_PATH=iam.sqlite
IAM_OIDC_PROVIDERS_FILE=/path/to/private-oidc-providers.json

# The standalone daemon reads upstream client secrets from owner-only paths
# inside IAM_OIDC_PROVIDERS_FILE. GOOGLE_* and GITHUB_* below are for the
# opt-in adapter smoke tests, not daemon login configuration.

# --- Google (OpenID Connect) ------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials (Web application).
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# Must byte-for-byte match an Authorized redirect URI on the Google OAuth app.
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/callback/google
# Optional; defaults to "openid email profile" when unset.
GOOGLE_SCOPES=openid email profile

# --- GitHub (OAuth 2.0) -----------------------------------------------------
# From GitHub -> Settings -> Developer settings -> OAuth Apps.
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
# Must match the Authorization callback URL on the GitHub OAuth app.
GITHUB_REDIRECT_URI=http://localhost:8080/v1/auth/callback/github
# Optional; defaults to "read:user user:email" when unset.
GITHUB_SCOPES=read:user user:email

# --- Real provider smoke tests (opt-in) -------------------------------------
# Off by default so CI runs only the deterministic fake provider. Set a flag to
# a truthy value (anything but 0/false/no/off) to run that provider's real smoke
# test, which additionally requires the matching *_CLIENT_ID/_SECRET/_REDIRECT_URI
# above. See docs/design/provider-setup.md for details.
# IAM_E2E_REAL_GOOGLE=1
# IAM_E2E_REAL_GITHUB=1
